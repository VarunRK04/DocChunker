# Backend: local (default) or pinecone
DOCCHUNKER_STORE=local
DOCCHUNKER_DATA_DIR=.docchunker
# Embedder: sentence-transformers (default) | openai | hashing
DOCCHUNKER_EMBEDDER=sentence-transformers
DOCCHUNKER_MODEL=
DOCCHUNKER_CHUNK_SIZE=800
DOCCHUNKER_CHUNK_OVERLAP=100

# Only for the pinecone store / openai embedder
PINECONE_API_KEY=
PINECONE_INDEX=docchunker
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
OPENAI_API_KEY=
